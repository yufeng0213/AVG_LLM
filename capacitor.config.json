{
  "appId": "com.avgllm.app",
  "appName": "AVG LLM",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#1a1a2e",
    "allowMixedContent": true
  },
  "plugins": {
    "StatusBar": {
      "style": "LIGHT",
      "overlaysWebView": false,
      "backgroundColor": "#0d0d1a"
    },
    "LocalNotifications": {
      "smallIcon": "ic_notification",
      "largeIcon": "ic_notification"
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorSQLite": {
      "androidIsEncryptionAvailable": false
    }
  }
}
