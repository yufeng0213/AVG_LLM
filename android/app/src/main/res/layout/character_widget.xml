<?xml version="1.0" encoding="utf-8"?>
<!-- 角色信息 Widget：立绘背景 + 取景框 + 对话气泡 + 语音按钮 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 底层：角色立绘背景 -->
    <ImageView
        android:id="@+id/widget_portrait_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_default_bg" />

    <!-- 上层：取景框PNG -->
    <ImageView
        android:id="@+id/widget_frame_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_frame_camera" />

    <!-- 内容层 -->
    <RelativeLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 对话气泡 -->
        <LinearLayout
            android:id="@+id/dialogue_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/widget_bubble_bg"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/dialogue_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:text="今天天气真好呢~"
                android:maxLines="2"
                android:ellipsize="end"
                android:gravity="center" />
        </LinearLayout>

        <!-- 角色名称 -->
        <TextView
            android:id="@+id/character_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottom_bar"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="4dp"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:text="角色名" />

        <!-- 底部栏 -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_info_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <!-- 状态 -->
            <TextView
                android:id="@+id/character_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="#00FF88"
                android:text="CONNECTED" />

            <!-- 麦克风图标（装饰） -->
            <ImageView
                android:id="@+id/mic_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="4dp"
                android:src="@drawable/widget_voice_btn" />
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>