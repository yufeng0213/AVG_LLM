  "story": {
    "chapters": [
      {
        "id": 1,
        "title": "第一章：误入深渊",
        "description": "资源收集途中，你们发现了这座废弃大楼...",
        "unlockCondition": { "cellsWalked": 6 },
        "scenes": [
          { "text": "废弃大楼的外墙斑驳，窗户大多破碎。你们推开了沉重的铁门...", "mood": "压抑" },
          { "text": "突然，一阵刺耳的金属摩擦声响起，大门在身后重重关上！", "mood": "紧张" },
          { "text": "一股无形的力量将你们分散，每个人被推向不同的方向...", "mood": "恐惧" }
        ]
      },
      {
        "id": 2,
        "title": "第二章：黑暗中的声音",
        "description": "走廊深处传来奇怪的声响...",
        "unlockCondition": { "cellsWalked": 15 },
        "scenes": [
          { "text": "走廊没有尽头，灯泡忽明忽暗。你能听到远处有脚步声...", "mood": "神秘" },
          { "text": "是同伴吗？你试图呼喊，但声音似乎被走廊吞噬...", "mood": "绝望" },
          { "text": "角落里，你发现了一张旧照片——照片上的人，似乎和你们有着某种联系...", "mood": "诡异" }
        ]
      },
      {
        "id": 3,
        "title": "第三章：无尽循环",
        "description": "走廊似乎永远不会结束...",
        "unlockCondition": { "cellsWalked": 25 },
        "scenes": [
          { "text": "你已经走了很久，但每次转弯都会回到相同的位置...", "mood": "困惑" },
          { "text": "墙上开始出现奇怪的符号，似乎在指引某个方向...", "mood": "好奇" },
          { "text": "你意识到，这座大楼不是一个普通的地方——它有自己的意志...", "mood": "震撼" }
        ]
      },
      {
        "id": 4,
        "title": "第四章：真相",
        "description": "大楼的秘密逐渐揭开...",
        "unlockCondition": { "cellsWalked": 33 },
        "scenes": [
          { "text": "在核心区域，你找到了大楼的「心脏」——一个古老的控制室...", "mood": "震撼" },
          { "text": "原来这座大楼曾是一个实验设施，某种实验失败了，留下了这个扭曲的空间...", "mood": "悲伤" },
          { "text": "你找到了关闭它的方法。走廊开始崩塌，你们终于能够逃离...", "mood": "解脱" }
        ]
      },
      {
        "id": 5,
        "title": "尾声：走出黑暗",
        "description": "终于，大门再次打开...",
        "unlockCondition": { "completeBoard": true },
        "scenes": [
          { "text": "阳光刺眼，你们终于走出了大楼。身后，那座建筑似乎在阳光下消失了...", "mood": "希望" },
          { "text": "每个人都带着奇怪的纪念品——也许是对这段经历的证明...", "mood": "感慨" },
          { "text": "「下次...我们还会再来吗？」走廊的声音在你脑海中回荡...", "mood": "神秘" }
        ]
      }
    ]
  },
